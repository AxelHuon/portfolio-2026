---
/*
 * Accueil : le hero, portrait plein écran passé sous le header, puis les services (web apps, sites vitrines,
 * e-commerce). Les projets récents, retirés à la demande d'Axel le 11 novembre 2026, restent
 * sur /projects.
 * Le <picture> du portrait est toujours servi : seul sans JS, sans WebGL ou en mouvement réduit ; sinon
 * src/scripts/pages/home.ts pose dessus un canvas WebGL (gl/hero-flow.ts) au même cadrage. home.focus règle ce cadrage
 * aux deux endroits : object-position ici, data-focus-x / -y pour le shader.
 * Le nom (site.name) passe une ligne par mot, chacune dans son masque, une lettre par span : home.ts les fait monter
 * une à une à l'entrée. Les lecteurs d'écran lisent le nom d'un bloc (sr-only), les lettres leur sont cachées.
 *
 * La transition vers les services (demandes d'Axel, 11 novembre 2026 : la section sur fond blanc, un passage très
 * fluide, la main sur le défilement). Pas de fondu de couleur (le bleu nuit et le blanc mélangés font un gris sale) :
 * la section blanche monte par-dessus le hero comme une feuille, un peu plus vite que la page, avec son contenu (le
 * titre arrive avec le blanc, sans vide au-dessus), son bord bombé (.services-edge) se gonflant puis s'aplatissant (à
 * plat au départ : rien ne dépasse sur le hero en haut de la page). Dessous, le hero s'enfonce à peine et s'assombrit
 * (.hero-dim). Tout suit le défilement (home.ts, en scrub). La feuille finit par des coins arrondis sur le
 * bleu nuit du footer. Sans JS ou en mouvement réduit : la feuille monte simplement, sans bord bombé ni enfoncement.
 * Les scènes essayées avant sont gardées sur les branches scene/portrait-se-range et scene/panorama.
 */
import Picture from "../components/Picture.astro";
import { home, services } from "../data/content";
import { site } from "../data/site";
import Base from "../layouts/Base.astro";

// le portrait couvre toute la largeur de l'écran
const HERO_SIZES = "100vw";
const objectPosition = `object-position:${home.focus.x * 100}% ${home.focus.y * 100}%`;
const nameLines = site.name.split(" ");
---

<Base page="home">
  <link slot="head" rel="preload" as="image" type="image/avif" imagesrcset={home.image.avif} imagesizes={HERO_SIZES} fetchpriority="high" />
  <div class="stage">
    <section class="hero" data-hero data-gl="pending" data-focus-x={home.focus.x} data-focus-y={home.focus.y} aria-labelledby="hero-title">
      <div class="hero-frame" data-hero-frame>
        <div class="hero-media mesh" data-hero-media>
          <Picture
            image={home.image}
            sizes={HERO_SIZES}
            loading="eager"
            fetchpriority="high"
            class="absolute inset-0 h-full w-full object-cover"
            style={objectPosition}
          />
        </div>
        <div class="hero-shade"></div>
        <div class="hero-text" data-reveal data-hero-text>
          <h1 id="hero-title" class="hero-title">
            <span class="sr-only">{site.name}</span>
            <span aria-hidden="true">
              {
                nameLines.map((line) => (
                  <span class="hero-line">
                    {[...line].map((char) => (
                      <span class="hero-char" data-reveal-char>
                        {char}
                      </span>
                    ))}
                  </span>
                ))
              }
            </span>
          </h1>
          <div class="hero-aside">
            <p data-reveal-fade>{home.role}</p>
            <p class="text-muted" data-reveal-fade>{home.intro}</p>
          </div>
        </div>
      </div>
      <div class="hero-dim" data-hero-dim></div>
    </section>

    <section class="services" data-services aria-labelledby="services-title">
      {/* le bord bombé de la feuille, qui s'aplatit en montant (home.ts) */}
      <div class="services-edge" data-services-edge aria-hidden="true"></div>
      <div class="services-head">
        <h2 id="services-title" class="services-title">
          <span class="mask"><span>{services.title}</span></span>
        </h2>
        <p class="services-intro">{services.intro}</p>
      </div>
      <ul class="services-list">
        {
          services.items.map((service) => (
            <li class="service" data-service>
              <h3 class="service-name">
                <span class="mask">
                  <span data-rise>{service.name}</span>
                </span>
              </h3>
              <div class="service-detail">
                <p class="service-summary">{service.summary}</p>
                <ul class="service-includes">
                  {service.includes.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ul>
      <p class="services-cta">
        {services.cta.text} <a href={services.cta.href}>{services.cta.label}</a>
      </p>
    </section>
  </div>
</Base>

<style>
  /* le hero remonte sous le header */
  .stage {
    position: relative;
    margin-top: calc(-1 * var(--spacing-header));
  }
  .hero {
    position: relative;
    isolation: isolate;
    height: 100svh;
    min-height: 34rem;
    overflow: clip;
  }
  /* le cadre du hero : c'est lui qui s'enfonce sous la feuille des services (home.ts) */
  .hero-frame {
    position: absolute;
    inset: 0;
    isolation: isolate;
  }
  .hero-media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  /* l'ombre du hero recouvert (home.ts) */
  .hero-dim {
    position: absolute;
    inset: 0;
    z-index: 3;
    background: var(--color-background);
    opacity: 0;
    pointer-events: none;
  }
  /* sans WebGL : le portrait en écran sur le dégradé (.mesh), comme le compose le shader */
  .hero-media :global(img) {
    mix-blend-mode: screen;
  }
  /* le canvas de gl/hero-flow.ts, posé sur le <picture> ; il n'intercepte rien (le pointeur est lu sur la fenêtre) */
  .hero-media :global(canvas) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  /* bas du hero fondu dans le fond : le texte reste lisible sur le t-shirt, la page enchaîne sans arête */
  .hero-shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(to top, var(--color-background) 0%, transparent 42%);
  }
  .hero-text {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    padding: 0 var(--spacing-gutter) clamp(1.5rem, 6vh, 4rem);
  }
  .hero-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(4rem, 14vw, 14rem);
    line-height: 0.88;
    letter-spacing: -0.045em;
  }
  /* le masque de chaque ligne, avec de la marge au-dessus : il ne rogne ni les capitales ni le « l » */
  .hero-line {
    display: block;
    overflow: clip;
    padding-top: 0.1em;
    margin-top: -0.1em;
  }
  /* une lettre : inline-block pour bouger seule (transform), basculée depuis son pied */
  .hero-char {
    display: inline-block;
    transform-origin: 0% 100%;
  }
  .hero-aside {
    max-width: 22rem;
    font-size: clamp(1rem, 1.2vw, 1.125rem);
    line-height: 1.45;
  }
  /* portrait caché le temps que le canvas arrive (home.ts) ; filet à 2,4 s, comme [data-reveal] (global.css) */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .hero[data-gl="pending"] .hero-media :global(img) {
      opacity: 0;
      animation: reveal-safety 2.4s step-end forwards;
    }
  }

  /* Services : une feuille blanche, le texte en bleu nuit (contraste 18:1 ; atténué à 65 % : 6,8:1), qui monte
     par-dessus le hero et finit par des coins arrondis sur le bleu nuit du footer. Le focus garde l'anneau bleu ciel,
     sur son halo bleu nuit */
  .services {
    --ink: var(--color-background);
    --ink-muted: color-mix(in srgb, var(--ink) 65%, #fff);
    --rule: color-mix(in srgb, var(--ink) 14%, transparent);
    position: relative;
    z-index: 2;
    /* la marge du haut, entre les deux essais (14vh : trop de blanc avec l'ancienne vague ; 5vh : trop serré une fois
       la feuille montée avec son contenu ; retours d'Axel, 11 novembre 2026) */
    padding: clamp(3.5rem, 10vh, 6.5rem) var(--spacing-gutter) clamp(5rem, 14vh, 9rem);
    border-radius: 0 0 32px 32px;
    background: #fff;
    color: var(--ink);
    container-type: inline-size;
  }
  /* avec la transition, la feuille garde l'avance prise en montant (SCENE.lead de home.ts : 0,4 écran, à changer
     ensemble) : la même marge en moins dessous, le footer reste collé à elle */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .services {
      margin-bottom: -40svh;
    }
  }
  .services ::selection {
    background: var(--ink);
    color: #fff;
  }
  /* le bord bombé de la feuille : une onde, une demi-ellipse blanche posée sur son bord haut, haute d'un quart d'écran et
     plus large que l'écran de 60 % (retour d'Axel, 11 novembre 2026 : une onde plus marquée). À plat au départ (scaleY 0 : en haut de la page, elle ne dépasse pas sur le hero) ; home.ts
     la gonfle quand la feuille monte, puis l'aplatit avant qu'elle touche le haut. Avec la transition seulement */
  .services-edge {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .services-edge {
      position: absolute;
      bottom: calc(100% - 1px);
      left: -30%;
      display: block;
      width: 160%;
      height: 25svh;
      border-radius: 50% 50% 0 0 / 100% 100% 0 0;
      background: #fff;
      transform: scaleY(0);
      transform-origin: 50% 100%;
      pointer-events: none;
    }
  }
  /* le titre et l'intro, comme le nom et le métier du hero : à gauche et à droite, alignés en bas */
  .services-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
  }
  .services-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(3.5rem, 10cqi, 10rem);
    line-height: 0.9;
    letter-spacing: -0.03em;
  }
  .services-intro {
    max-width: 22rem;
    color: var(--ink-muted);
    font-size: clamp(1rem, 1.2vw, 1.125rem);
    line-height: 1.45;
  }
  /* un masque : son contenu monte de dessous à l'arrivée (home.ts) ; de la marge pour les jambages et les capitales */
  .mask {
    display: block;
    overflow: clip;
    padding-block: 0.08em;
    margin-block: -0.08em;
  }
  .mask > [data-rise] {
    display: block;
  }
  .services-list {
    margin-top: clamp(3rem, 9vh, 6rem);
    border-bottom: 1px solid var(--rule);
  }
  /* un service : le nom en grand, puis le résumé et ce qu'il comprend ; côte à côte dans une colonne assez large */
  .service {
    display: grid;
    gap: 1.25rem;
    padding-block: clamp(2rem, 6vh, 4rem);
    border-top: 1px solid var(--rule);
  }
  @container (min-width: 56rem) {
    .service {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: 3rem;
    }
    .service-detail {
      padding-top: 0.75rem;
    }
  }
  .service-name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2.5rem, 6.5cqi, 6.5rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
  }
  .service-detail {
    max-width: 32rem;
  }
  .service-summary {
    font-size: clamp(1.125rem, 1.5vw, 1.375rem);
    line-height: 1.4;
  }
  .service-includes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem 1.5rem;
    margin-top: 1.5rem;
    color: var(--ink-muted);
    font-size: 0.9375rem;
    line-height: 1.4;
  }
  .services-cta {
    margin-top: clamp(3rem, 9vh, 6rem);
    font-size: clamp(1.25rem, 2.2vw, 2rem);
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  /* le soulignement se renforce en douceur au survol, comme la bordure du bouton Menu */
  .services-cta a {
    font-weight: 500;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: color-mix(in srgb, var(--ink) 35%, transparent);
    text-underline-offset: 0.18em;
    transition: text-decoration-color 0.35s ease;
  }
  .services-cta a:hover {
    text-decoration-color: var(--ink);
  }

</style>
