---
/*
 * En-tête : le logo et le nom du site à gauche, posé en haut de page (absolu : il défile avec elle) ; à droite, fixée pour rester
 * à portée au défilement, un bouton « Menu » qui ouvre un petit panneau (src/scripts/chrome/menu.ts) : les liens, un
 * filet, l'e-mail et les profils (GitHub, LinkedIn). L'idée d'un menu compact vient d'une référence d'Axel (11 novembre 2026), le
 * dessin est celui du site : bleu nuit, Satoshi, point bleu ciel pour la page courante. Le bouton : un rond bleu nuit
 * sans texte (choix d'Axel sur maquettes, 12 novembre 2026 : « rond seul »), deux traits blancs qui tournent en croix à
 * l'ouverture ; son nom (« Menu ») est dit aux lecteurs d'écran par aria-label.
 * Le header occupe --spacing-header, réservé en haut de main ; le hero de l'accueil remonte dessous. Le nom du loader
 * (global.css, .loader-name) se pose exactement sur le sien : à changer ensemble.
 * Sans JS : pas de menu, les liens restent affichés en ligne (variante no-js de global.css).
 * Non persistant : remplacé à chaque navigation, son aria-current vient du serveur.
 */
import { contact, nav, site, uiText, type PageId } from "../data/site";
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";

interface Props {
  page: PageId;
}

const { page } = Astro.props;
const current = (id: string) => (id === page ? "page" : undefined);
---

<header id="site-header" class="site-header">
  <a href="/" class="site-name" aria-current={current("home")}><Logo />{site.name}</a>

  {/* sans JS seulement : les liens en ligne */}
  <nav aria-label={uiText.mainNav} class="hidden no-js:block">
    <ul class="flex flex-wrap gap-x-6 gap-y-2">
      {
        nav.map((item) => (
          <li>
            <a href={item.href} aria-current={current(item.id)}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="actions" data-header-actions>
    <button type="button" class="toggle" data-menu-toggle aria-expanded="false" aria-controls="site-menu" aria-label={uiText.menu}>
      {/* deux traits (Phosphor equals), qui laissent place à une croix (x) à l'ouverture */}
      <span class="toggle-icon toggle-open" aria-hidden="true"><Icon name="equals" /></span>
      <span class="toggle-icon toggle-close" aria-hidden="true"><Icon name="x" /></span>
    </button>
  </div>

  <div id="site-menu" class="menu" hidden>
    <nav aria-label={uiText.mainNav}>
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={current(item.id)} class="menu-link" data-menu-item>
                {item.label}
                <span class="menu-dot" aria-hidden="true" />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="menu-foot" data-menu-item>
      <a href={`mailto:${contact.email}`} class="menu-small">{contact.email}</a>
      {
        contact.socials.length > 0 && (
          <ul class="menu-socials">
            {contact.socials.map((social) => (
              <li>
                <a href={social.href} target="_blank" rel="me noopener noreferrer" class="menu-small">
                  {social.label}
                  <Icon name="arrow-up-right" />
                  <span class="sr-only"> {uiText.newTab}</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</header>

<style>
  .site-header {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: var(--spacing-header);
    padding: 0 var(--spacing-gutter);
  }
  /* le logo puis le nom ; le loader reprend exactement cette mise en page (global.css, .loader-name) */
  .site-name {
    display: flex;
    gap: 0.625rem;
    align-items: center;
    font-weight: 500;
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
  }

  /* le bouton du menu : fixe, en haut à droite, centré dans la hauteur du header */
  .actions {
    position: fixed;
    top: calc((var(--spacing-header) - 3rem) / 2);
    right: var(--spacing-gutter);
    z-index: 30;
  }
  :global(html:not(.js)) .actions {
    display: none;
  }
  /* un rond bleu nuit, de la matière du panneau (bordure fine, qui s'éclaire au survol et menu ouvert, en douceur :
     trop brusque sans transition, retour d'Axel) ; il grandit un peu au survol (scale, pas transform : l'entrée du
     header anime son transform). Les deux traits tournent d'un quart de tour en s'effaçant, la croix arrive en sens
     inverse */
  .toggle {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid color-mix(in srgb, var(--color-foreground) 16%, transparent);
    border-radius: 50%;
    background: var(--color-background);
    color: var(--color-foreground);
    font-size: 1.25rem;
    transition:
      border-color 0.35s ease,
      scale 0.45s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .toggle:hover,
  .toggle[aria-expanded="true"] {
    border-color: color-mix(in srgb, var(--color-foreground) 34%, transparent);
  }
  .toggle:hover {
    scale: 1.06;
  }
  .toggle-icon {
    display: flex;
    grid-area: 1 / 1;
    transition:
      transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1),
      opacity 0.25s ease;
  }
  .toggle-close {
    opacity: 0;
    transform: rotate(-90deg) scale(0.6);
  }
  .toggle[aria-expanded="true"] .toggle-open {
    opacity: 0;
    transform: rotate(90deg) scale(0.6);
  }
  .toggle[aria-expanded="true"] .toggle-close {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .toggle,
    .toggle-icon {
      transition: none;
    }
  }

  /* le panneau : une carte bleu nuit sous le bouton, alignée à droite ; menu.ts la fait monter
     d'en bas en fondu, ses lignes à la suite */
  .menu {
    position: fixed;
    top: calc((var(--spacing-header) + 3rem) / 2 + 0.5rem);
    right: var(--spacing-gutter);
    z-index: 30;
    width: min(18rem, calc(100vw - 2 * var(--spacing-gutter)));
    padding: 0.75rem;
    border: 1px solid color-mix(in srgb, var(--color-foreground) 12%, transparent);
    border-radius: 16px;
    background: var(--color-background);
    box-shadow: 0 1.5rem 3rem -1.5rem rgb(0 0 0 / 0.6);
  }
  .menu[hidden] {
    display: none;
  }
  .menu-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 2.75rem;
    padding: 0 0.75rem;
    border-radius: 10px;
    font-weight: 500;
    font-size: 1.25rem;
    letter-spacing: -0.01em;
  }
  .menu-link:hover {
    background: color-mix(in srgb, var(--color-foreground) 8%, transparent);
  }
  .menu-dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--color-accent);
    opacity: 0;
  }
  .menu-link[aria-current="page"] .menu-dot {
    opacity: 1;
  }
  .menu-foot {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-top: 0.5rem;
    padding: 0.75rem 0.75rem 0.25rem;
    border-top: 1px solid color-mix(in srgb, var(--color-foreground) 12%, transparent);
  }
  .menu-socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
  }
  /* un petit lien du pied du menu ; la flèche des profils (Icon.astro) suit leur nom */
  .menu-small {
    display: inline-flex;
    align-items: center;
    gap: 0.2em;
    min-height: 1.75rem;
    overflow: hidden;
    color: var(--color-muted);
    font-size: 0.875rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .menu-small:hover {
    color: var(--color-foreground);
  }
</style>
